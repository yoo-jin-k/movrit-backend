    timestamp created_at
  }
  shipment {
    bigint id PK
    bigint order_id FK
    varchar courier_code
    varchar tracking_number
    varchar status
    timestamp shipped_at
    timestamp delivered_at
    timestamp created_at
    timestamp updated_at
  }
  shipment_item {
    bigint id PK
    bigint shipment_id FK
    bigint order_item_id FK
    bigint quantity
    timestamp created_at
  }
  settlement {
    bigint id PK
    bigint preorder_id FK
