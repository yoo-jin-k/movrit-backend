# MOVRIT 배포(운영) 환경 변수 양식입니다. 값은 배포 플랫폼의 환경 변수(비밀값) 설정 화면에만 넣고, 이 파일에는 이름만 둡니다.
# 실제 값이 든 파일은 Git에 올리지 않습니다.

# 운영 설정 켜기(application-prod.properties)
SPRING_PROFILES_ACTIVE=

# DB 접속(예: jdbc:postgresql://호스트:5432/DB이름?sslmode=require)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 로그인 토큰 서명 키(32바이트 이상). 예: openssl rand -hex 32. 로컬과 다른 값을 씁니다.
JWT_SECRET=

# 업로드 위치: 공개 이미지와 비공개 파일(구매 인증·채팅 첨부 등)을 서로 다른 영구 저장 폴더로 지정합니다(겹치면 서버가 뜨지 않음).
UPLOAD_DIR=
PRIVATE_UPLOAD_DIR=

# 프론트 주소. CORS 허용 주소는 쉼표로 구분하며 '*'는 쓸 수 없습니다.
FRONTEND_BASE_URL=
CORS_ALLOWED_ORIGINS=

# 소셜 로그인(배포 주소의 콜백을 각 개발자 앱에 등록)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# API 문서는 운영에서 기본으로 꺼져 있습니다. 켤 때만 true
API_DOCS_ENABLED=
