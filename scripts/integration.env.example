# MOVRIT 로컬 통합 환경 비밀값 양식입니다. 이 파일을 저장소 상위 폴더에 .movrit-integration.env 로 복사해 값을 채웁니다.
# 실제 값이 든 파일은 Git에 올리지 않습니다.

# Google Cloud Console > Google 인증 플랫폼 > 클라이언트(웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:18080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao Developers > 앱 > 플랫폼 키 > REST API 키 (Redirect URI: http://localhost:18080/api/auth/kakao/callback)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ───────── SNS 채널 계정 연결(설정 > SNS 채널 연결) ─────────
# 각 개발자 앱의 '돌아올 주소(Redirect URI)'에 아래 주소를 그대로 등록합니다(기본 화면 주소 http://localhost:5174 기준).
#   인스타그램:   http://localhost:5174/channel-connect/callback/instagram
#   유튜브:       http://localhost:5174/channel-connect/callback/youtube
#   네이버 블로그: http://localhost:5174/channel-connect/callback/naver-blog
# 화면 주소가 다르면(예: https 터널) 아래 값으로 바꾸고, 위 주소들도 같은 값으로 등록합니다.
CHANNEL_CONNECT_REDIRECT_BASE=
# 로그인 연결을 켤 때 true로 바꿉니다. 비우거나 false면 직접 등록(운영자 확인)만 사용합니다.
CHANNEL_CONNECT_LOGIN_ENABLED=

# Meta for Developers > 앱 > Instagram > 'Instagram 로그인을 사용한 API 설정' > Instagram 앱 ID·시크릿
# 권한: instagram_business_basic. 프로페셔널(비즈니스·크리에이터) 계정만 연결됩니다. 메타는 https 주소만 허용할 수 있습니다.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# 비워 두면 위 GOOGLE_* 키를 함께 씁니다. Google Cloud Console에서 YouTube Data API v3를 사용 설정하고 돌아올 주소를 추가 등록합니다.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# NAVER Developers > 애플리케이션 등록 > 사용 API: 네이버 로그인(제공 정보: 이메일 필수) > 서비스 URL·Callback URL 등록
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 로그인 토큰 서명 키(32바이트 이상 임의 문자열). 예: openssl rand -hex 32
JWT_SECRET=

# 소개글 인증 코드 - 인스타그램 자동 확인(선택). 메타 Graph API Business Discovery에 쓰는 우리 서비스의 인스타그램 비즈니스 계정 ID와 장기 접근 토큰.
# 비어 있으면 인스타그램 소개글 코드는 운영자 확인으로 넘어갑니다. 네이버 블로그는 공개 RSS로 확인하므로 키가 필요 없습니다.
INSTAGRAM_DISCOVERY_ACCOUNT_ID=
INSTAGRAM_DISCOVERY_TOKEN=
