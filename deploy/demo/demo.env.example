# 공개 시연 서버용 환경 값 양식입니다. 서버에서 이 파일을 .env로 복사한 뒤 값을 직접 채웁니다(.env는 Git에 올라가지 않습니다).
#   cp demo.env.example .env && chmod 600 .env

# 접속 도메인(https:// 없이). 도메인이 없으면 서버 공인 IP로 <IP의 점을 하이픈으로>.sslip.io 를 쓸 수 있습니다. 예: 203-0-113-10.sslip.io
SITE_ADDRESS=

# DB 비밀번호: openssl rand -hex 16 으로 만든 값
DB_PASSWORD=
# 로그인 토큰 서명 키(32자 이상): openssl rand -hex 32 로 만든 값. 로컬과 다른 값을 씁니다.
JWT_SECRET=

# (선택) 네이버 지도 Client ID. NCP 콘솔의 Maps 앱에 https://SITE_ADDRESS 를 Web 서비스 URL로 등록해야 지도가 보입니다.
VITE_NAVER_MAP_KEY_ID=

# (선택) 소셜 로그인. 각 개발자 앱에 https://SITE_ADDRESS/api/auth/{google|kakao}/callback 을 등록합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# (선택) AI 캠페인 초안·제출 전 점검. 공개 서버에서는 누구나 부를 수 있어 비용이 생깁니다. 비우면 견본 결과로 동작합니다.
ANTHROPIC_API_KEY=

# (선택) API 문서(Swagger) 공개 여부. 기본 false
API_DOCS_ENABLED=false

# (선택) 화면 저장소 위치. 기본은 백엔드 저장소 옆의 ../movrit-frontend 입니다.
FRONTEND_DIR=
