# docker compose 실행용 환경 값 양식입니다. 이 파일을 .env로 복사한 뒤 값을 직접 채워 주세요(.env는 Git에 올라가지 않습니다).
#   cp docker.env.example .env
# DB 비밀번호: 이 컴퓨터의 Docker 안에서만 쓰는 값입니다. 예: openssl rand -hex 16 으로 만든 값
DB_PASSWORD=
# JWT 서명 키: 32자 이상. 예: openssl rand -hex 32 으로 만든 값
JWT_SECRET=
# (선택) 소셜 로그인 키. 비워 두면 이메일 가입·로그인만 씁니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
# (선택) 프론트 저장소 위치. 기본은 이 저장소 옆의 ../movrit-frontend 입니다.
FRONTEND_DIR=
